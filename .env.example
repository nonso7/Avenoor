# Public URL of the site, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://avenor.com

# Where waitlist sign-ups are forwarded (JSON POST), e.g. a Formspree, Zapier,
# Make, or Slack incoming-webhook URL. Without it, sign-ups are rejected in
# production and only logged in development.
WAITLIST_WEBHOOK_URL=
